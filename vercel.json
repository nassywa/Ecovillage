{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/(src|database|api|\\.env.*|README\\.md|composer\\.json)(/.*)?", "status": 404 },
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=86400" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
