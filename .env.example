# Salin menjadi .env untuk pengembangan lokal.
# Di Vercel, isi variabel yang sama di Project Settings → Environment Variables.

# Pilih salah satu: DATABASE_URL atau DB_* terpisah
# DATABASE_URL=mysql://user:password@host:port/nama_db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecovillage
DB_USER=root
DB_PASS=

# Wajib "true" untuk MySQL cloud (Aiven, dll)
DB_SSL=false
# Opsional: isi sertifikat CA (teks PEM lengkap) dari penyedia database
# DB_SSL_CA=

# Kunci untuk membuka halaman /setup (instalasi database). Ganti dengan teks acak.
SETUP_KEY=ganti-dengan-kunci-rahasia

# Tampilkan detail error (jangan aktifkan saat lomba)
APP_DEBUG=false
